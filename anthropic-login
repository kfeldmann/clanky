#!/bin/sh
# Run the OAuth login workflow for Anthropic
#
# Mounts ~/.clanky as the container user's ~/.clanky (user-scope config/state).
# All state therefore stays in this mount, so the container is run with --rm.
#
# Terminal detection:
#   real terminal            -> -it
#   pipe/redirect, data ready-> -i
#   pipe/redirect, no data   -> no flags

set -eu

# Make sure the host side of the user-scope mount exists and is owned by us
# (docker would otherwise create it as root).
mkdir -p "$HOME/.clanky"

if [ -t 0 ]; then
    INTERACTIVE_FLAGS="-it" # real terminal
elif read -t 0 <&0; then
    INTERACTIVE_FLAGS="-i"  # pipe/redirect with data ready
else
    INTERACTIVE_FLAGS=""    # pipe/redirect but no data — skip -i
fi

# ${INTERACTIVE_FLAGS} is intentionally unquoted: empty expands to nothing,
# "-it"/"-i" word-splits into docker run's -i/-t flags.
docker run \
  ${INTERACTIVE_FLAGS} --rm \
  -v "$HOME/.clanky:/home/clanky/.clanky" \
  -w /work \
  --entrypoint /usr/local/bin/clanky-provider-anthropic \
  clanky-runner:latest login
